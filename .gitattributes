# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure shell scripts use LF line endings
*.sh text eol=lf

# Source code and configuration files
configs/m5_rules.json text eol=crlf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.ini text eol=lf
*.toml text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Binary files
*.bin binary
*.pkl binary
*.txt.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.docx binary
