# ---------------- Runtime ----------------
XS_ENV=development
XS_DEMO_MODE=true
XS_LOG_LEVEL=INFO
XS_BACKEND_HOST=0.0.0.0
XS_BACKEND_PORT=8000
XS_FRONTEND_PORT=8501
XS_API_BASE_URL=http://localhost:8000

# Input mode: vector | raw_pe
XS_INPUT_MODE=vector

# ---------------- Paths ----------------
XS_CONFIG_DIR=./configs
XS_ARTIFACT_DIR=./artifacts
XS_MODEL_DIR=./models
XS_AUDIT_LOG_PATH=./artifacts/audit/events.jsonl

# ---------------- Microsoft SQL Server ----------------
MSSQL_DB=xsentinel
MSSQL_PORT=1433
# Option 1: Local Windows with Windows Authentication (No password needed)
XS_DATABASE_URL=mssql+pyodbc://localhost/xsentinel?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
# Option 2: SQL Server Authentication (Docker / Remote host / Linux)
# XS_DATABASE_URL=mssql+pyodbc://sa:YourStrong!Pass123@localhost:1433/xsentinel?driver=ODBC+Driver+17+for+SQL+Server
XS_DATABASE_REQUIRED=true
XS_EXPECTED_DB_REVISION=0002_v3_jev_ai_audit
XS_DB_POOL_SIZE=10
XS_DB_MAX_OVERFLOW=20
XS_DB_POOL_RECYCLE_SECONDS=1800

# ---------------- Security ----------------
XS_API_AUTH_MODE=none
XS_ALLOWED_ORIGINS=http://localhost:8501
XS_MAX_UPLOAD_BYTES=52428800

# ---------------- Jev AI / LM Studio ----------------
XS_JEV_AI_ENABLED=false
XS_JEV_AI_BASE_URL=http://localhost:1234/v1
XS_JEV_AI_MODEL=jev-local-TBD
XS_JEV_AI_TIMEOUT_SECONDS=60
XS_JEV_AI_TEMPERATURE=0.1
XS_JEV_AI_MAX_CONTEXT_CHARS=30000
XS_JEV_AI_PROMPT_VERSION=jev-v3.0.0
XS_JEV_AI_ADVISORY_ONLY=true
XS_JEV_AI_LOCAL_ONLY=true
XS_JEV_AI_STORE_RESPONSE_TEXT=true
XS_JEV_AI_STORE_PROMPT_TEXT=false

# ---------------- Scientific gates (targets, not verified results) ----------------
XS_RESEARCH_ASR_GATE=0.50
XS_PRODUCTION_ASR_TARGET=0.80
XS_FPR_TARGET=0.01
XS_LATENCY_P95_MS_TARGET=10.0
XS_CIRCUIT_BREAKER_MS=8.0
